RewriteEngine On
RewriteBase /

# External redirects (tracked by Hostinger analytics)
Redirect 302 /tractable/se3-labs https://jobs.ashbyhq.com/se3/9e554e3e-94fe-4e0d-8aa4-7928849a04e7/application

# If the requested file or directory doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Optional: Set Permissions-Policy header to suppress console warnings
<IfModule mod_headers.c>
    Header set Permissions-Policy "attribution-reporting=(),run-ad-auction=(),private-state-token-redemption=(),private-state-token-issuance=(),join-ad-interest-group=(),browsing-topics=()"
</IfModule>

# Rewrite everything else to index.html (React entry point)
RewriteRule ^ index.html [L]
